# ─────────────────────────────────────────────────────────────────────────────
# Zync environment configuration
# Copy to .env.local and fill in. Every integration is OPTIONAL — the app runs
# without any of these; features light up as you add keys.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://zync.app

# ── Storage / transfer coordination (optional) ──────────────────────────────
# Redis enables multi-instance scaling; without it an in-memory store is used.
# REDIS_URL=redis://localhost:6379

# WebRTC TURN (optional, for restrictive networks)
# COTURN_ENABLED=true
# TURN_HOST=127.0.0.1
# TURN_REALM=zync.app
# STUN_SERVER=stun:stun.l.google.com:19302

# Secret used to sign anonymous session cookies (CHANGE IN PRODUCTION)
# FILEPIZZA_SECRET=replace-with-a-long-random-string

# ── Supabase (auth + storage) ───────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_AVATAR_BUCKET=avatars
# Service-role key (server-only) — required for account deletion. Keep secret!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Enable "Login with Google" in Supabase Auth > Providers > Google.
# Enable TOTP MFA in Supabase Auth > Multi-Factor for 2FA support.

# ── Super admin ─────────────────────────────────────────────────────────────
# Comma-separated emails granted access to /admin
# ADMIN_EMAILS=contact@zestcommere.in

# ── Hostinger email (SMTP) for the contact form ─────────────────────────────
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@zestcommere.in
# SMTP_PASS=your-mailbox-password
# SMTP_FROM=contact@zestcommere.in

# ── Profile-photo upload via your PHP endpoint (preferred when set) ─────────
# Deploy deploy/hostinger/api4/ to https://api.zestcommerce.in/api4/
# The token MUST match ZYNC_UPLOAD_SECRET in api4/config.php.
# HOSTINGER_UPLOAD_URL=https://api.zestcommerce.in/api4/upload.php
# HOSTINGER_API_TOKEN=98ada212409826373df0142b408e8282870b166d9d60377e237204aa63d5018e6bed72f73eed8afa15b10bc10cfbf78e

# ── Google Analytics 4 (optional) ───────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── reCAPTCHA v3 (optional, protects the contact form) ──────────────────────
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
# RECAPTCHA_SECRET_KEY=your-secret-key
